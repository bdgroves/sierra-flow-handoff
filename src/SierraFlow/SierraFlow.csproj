<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SIERRA-FLOW for .NET: a port of the GnuCOBOL batch job in bdgroves/sierra-flow-cobol.
    No NuGet packages, on purpose. Like the COBOL it replaces, it needs nothing
    but its runtime and three CSV files, so it builds offline and runs anywhere
    .NET 8 runs (Windows, Linux, a GitHub runner, an Azure Function).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>sierraflow</AssemblyName>
    <RootNamespace>SierraFlow</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
